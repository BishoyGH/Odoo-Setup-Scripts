# Pure logic with no side effects: tuning profiles, config rendering,
# module resolution and backup retention. Runs on any PowerShell
# (5.1 on Windows, 7+ anywhere) so it can be unit-tested on Linux CI.

Set-StrictMode -Version 2.0

function Get-RamProfileName {
    <# Maps physical RAM to a tuning profile: 4GB, 8GB or 16GB. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][double]$TotalMemoryGB)
    # Windows reports slightly less than the installed amount (e.g. 7.8 GB for 8 GB).
    if ($TotalMemoryGB -lt 6.5) { return '4GB' }
    if ($TotalMemoryGB -lt 14) { return '8GB' }
    return '16GB'
}

function Get-TuningProfile {
    [CmdletBinding()]
    param([Parameter(Mandatory)][ValidateSet('4GB', '8GB', '16GB')][string]$Name)
    $profiles = @{
        '4GB'  = [ordered]@{
            shared_buffers = '384MB'; effective_cache_size = '1GB'; work_mem = '8MB'
            maintenance_work_mem = '96MB'; max_connections = 40; max_wal_size = '1GB'
            wal_buffers = '8MB'; db_maxconn = 24; max_cron_threads = 1
        }
        '8GB'  = [ordered]@{
            shared_buffers = '1GB'; effective_cache_size = '3GB'; work_mem = '16MB'
            maintenance_work_mem = '256MB'; max_connections = 80; max_wal_size = '2GB'
            wal_buffers = '16MB'; db_maxconn = 48; max_cron_threads = 2
        }
        '16GB' = [ordered]@{
            shared_buffers = '2GB'; effective_cache_size = '8GB'; work_mem = '32MB'
            maintenance_work_mem = '512MB'; max_connections = 120; max_wal_size = '4GB'
            wal_buffers = '16MB'; db_maxconn = 64; max_cron_threads = 2
        }
    }
    return $profiles[$Name]
}

function ConvertTo-PostgresTuningConf {
    <# Renders the include file appended to postgresql.conf. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][System.Collections.IDictionary]$Tuning,
        [Parameter(Mandatory)][int]$Port,
        [bool]$Ssd = $true,
        [string]$ProfileName = ''
    )
    $randomPageCost = '4.0'
    if ($Ssd) { $randomPageCost = '1.1' }
    $lines = @(
        '# Generated by Odoo-Setup-Scripts. Re-run setup (Repair) to regenerate.'
        ('# Profile: {0}  Disk: {1}' -f $ProfileName, $(if ($Ssd) { 'SSD' } else { 'HDD' }))
        "listen_addresses = 'localhost'"
        ('port = {0}' -f $Port)
        ('max_connections = {0}' -f $Tuning.max_connections)
        ("shared_buffers = '{0}'" -f $Tuning.shared_buffers)
        ("effective_cache_size = '{0}'" -f $Tuning.effective_cache_size)
        ("work_mem = '{0}'" -f $Tuning.work_mem)
        ("maintenance_work_mem = '{0}'" -f $Tuning.maintenance_work_mem)
        ("wal_buffers = '{0}'" -f $Tuning.wal_buffers)
        ("max_wal_size = '{0}'" -f $Tuning.max_wal_size)
        "min_wal_size = '256MB'"
        'checkpoint_completion_target = 0.9'
        ('random_page_cost = {0}' -f $randomPageCost)
        'default_statistics_target = 100'
        'jit = off'
        "password_encryption = 'scram-sha-256'"
        "idle_in_transaction_session_timeout = '15min'"
        "log_min_duration_statement = '2s'"
        "log_line_prefix = '%m [%p] %u@%d '"
        'logging_collector = on'
        "log_directory = 'log'"
        "log_filename = 'postgresql-%a.log'"
        'log_truncate_on_rotation = on'
        "log_rotation_age = '1d'"
        "log_rotation_size = '0'"
        "timezone = 'Africa/Cairo'"
        "log_timezone = 'Africa/Cairo'"
    )
    return ($lines -join "`r`n") + "`r`n"
}

function Get-DemoArguments {
    <# CLI flags for demo data. 18.0 loads demo by default; 19.0+ does not. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$Version, [bool]$WithDemo = $false)
    $major = [int]($Version.Split('.')[0])
    if ($major -le 18) {
        if ($WithDemo) { return @() }
        return @('--without-demo=all')
    }
    if ($WithDemo) { return @('--with-demo') }
    return @()
}

function New-OdooConfSettings {
    <# Builds the ordered key/value set for odoo.conf. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][ValidateSet('dev', 'prod')][string]$Mode,
        [Parameter(Mandatory)][string]$Version,
        [Parameter(Mandatory)][System.Collections.IDictionary]$Tuning,
        [Parameter(Mandatory)][string[]]$AddonsPath,
        [Parameter(Mandatory)][string]$DataDir,
        [Parameter(Mandatory)][string]$DbPassword,
        [Parameter(Mandatory)][string]$MasterPassword,
        [int]$DbPort = 5432,
        [int]$HttpPort = 8069,
        [string]$DbName = '',
        [string]$PgPath = '',
        [string]$BinPath = '',
        [bool]$WithDemo = $false
    )
    $s = [ordered]@{}
    $s['addons_path'] = ($AddonsPath -join ',')
    $s['data_dir'] = $DataDir
    $s['admin_passwd'] = $MasterPassword
    $s['db_host'] = '127.0.0.1'
    $s['db_port'] = $DbPort
    $s['db_user'] = 'odoo'
    $s['db_password'] = $DbPassword
    $s['db_maxconn'] = $Tuning.db_maxconn
    $s['max_cron_threads'] = $Tuning.max_cron_threads
    $s['http_port'] = $HttpPort
    $s['unaccent'] = 'True'
    if ($PgPath) { $s['pg_path'] = $PgPath }
    if ($BinPath) { $s['bin_path'] = $BinPath }

    $major = [int]($Version.Split('.')[0])
    $demoKey = 'with_demo'
    $demoValue = [string]$WithDemo
    if ($major -le 18) {
        $demoKey = 'without_demo'
        $demoValue = $(if ($WithDemo) { 'False' } else { 'all' })
    }

    if ($Mode -eq 'prod') {
        $s['http_interface'] = '0.0.0.0'
        $s['list_db'] = 'False'
        $s['log_level'] = 'warn'
        $s[$demoKey] = $(if ($major -le 18) { 'all' } else { 'False' })
        if ($DbName) {
            $s['db_name'] = $DbName
            $s['dbfilter'] = '^' + [regex]::Escape($DbName) + '$'
        }
    }
    else {
        $s['http_interface'] = '127.0.0.1'
        $s['list_db'] = 'True'
        $s['log_level'] = 'info'
        $s[$demoKey] = $demoValue
    }
    # No logfile: Odoo logs to stdout and the Windows service wrapper rolls the files.
    return $s
}

function ConvertTo-OdooConf {
    [CmdletBinding()]
    param([Parameter(Mandatory)][System.Collections.IDictionary]$Settings)
    $lines = @('; Generated by Odoo-Setup-Scripts. Re-run setup (Repair) to regenerate.', '[options]')
    foreach ($key in $Settings.Keys) {
        $value = $Settings[$key]
        if ($value -is [bool]) { $value = [string]$value }
        $lines += ('{0} = {1}' -f $key, $value)
    }
    return ($lines -join "`r`n") + "`r`n"
}

function Resolve-AddonSelection {
    <#
      Expands selected app/bundle keys into module and repository lists.
      Returns @{ Modules = [string[]]; Repos = [string[]] }.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][System.Collections.IDictionary]$Catalog,
        [string[]]$AppKeys = @(),
        [string[]]$BundleKeys = @()
    )
    $modules = New-Object System.Collections.Generic.List[string]
    $repos = New-Object System.Collections.Generic.List[string]
    foreach ($app in $Catalog.Apps) {
        if ($AppKeys -contains $app.Key) { foreach ($m in $app.Modules) { if (-not $modules.Contains($m)) { $modules.Add($m) } } }
    }
    foreach ($bundle in $Catalog.OcaBundles) {
        if ($BundleKeys -contains $bundle.Key) {
            foreach ($m in $bundle.Modules) { if (-not $modules.Contains($m)) { $modules.Add($m) } }
            foreach ($r in $bundle.Repos) { if (-not $repos.Contains($r)) { $repos.Add($r) } }
        }
    }
    return @{ Modules = [string[]]$modules.ToArray(); Repos = [string[]]$repos.ToArray() }
}

function Split-ModulesByAvailability {
    <# Splits module names into those found in any addons directory and those missing. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Modules,
        [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$AvailableModules
    )
    $present = @($Modules | Where-Object { $AvailableModules -contains $_ })
    $missing = @($Modules | Where-Object { $AvailableModules -notcontains $_ })
    return @{ Present = $present; Missing = $missing }
}

function Get-BackupFileName {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$DbName, [Parameter(Mandatory)][datetime]$Timestamp)
    return ('{0}_{1}.zip' -f $DbName, $Timestamp.ToString('yyyy-MM-dd_HHmm'))
}

function Select-BackupsToPrune {
    <#
      Returns the backups older than RetentionDays, but never touches the
      newest KeepMinimum backups (so a long-off PC never deletes its last copies).
      Files need Name and LastWriteTime properties.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Files,
        [Parameter(Mandatory)][int]$RetentionDays,
        [int]$KeepMinimum = 3,
        [datetime]$Now = (Get-Date)
    )
    $sorted = @($Files | Sort-Object -Property LastWriteTime -Descending)
    if ($sorted.Count -le $KeepMinimum) { return @() }
    $cutoff = $Now.AddDays(-$RetentionDays)
    return @($sorted | Select-Object -Skip $KeepMinimum | Where-Object { $_.LastWriteTime -lt $cutoff })
}

function Test-DatabaseName {
    [CmdletBinding()]
    param([AllowEmptyString()][string]$Name)
    return ($Name -match '^[A-Za-z][A-Za-z0-9_.-]{0,62}$')
}

function ConvertTo-DatabaseName {
    <# Suggests a database name from a company name (ASCII letters, digits, underscore). #>
    [CmdletBinding()]
    param([AllowEmptyString()][string]$CompanyName)
    $slug = ($CompanyName.ToLowerInvariant() -replace '[^a-z0-9]+', '_').Trim('_')
    if ($slug -eq '' -or $slug -notmatch '^[a-z]') { $slug = 'odoo' + $(if ($slug) { '_' + $slug } else { '' }) }
    if ($slug.Length -gt 40) { $slug = $slug.Substring(0, 40).TrimEnd('_') }
    return $slug
}

function Get-FreePort {
    <# First port from the candidates not present in UsedPorts. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][int[]]$Candidates, [AllowEmptyCollection()][int[]]$UsedPorts = @())
    foreach ($p in $Candidates) { if ($UsedPorts -notcontains $p) { return $p } }
    throw ('No free port among: {0}' -f ($Candidates -join ', '))
}

function Get-OdooServiceArguments {
    <# Command line passed to python.exe by the Windows service. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$OdooBin,
        [Parameter(Mandatory)][string]$ConfigFile,
        [Parameter(Mandatory)][ValidateSet('dev', 'prod')][string]$Mode
    )
    $cmd = '"{0}" -c "{1}"' -f $OdooBin, $ConfigFile
    if ($Mode -eq 'dev') { $cmd += ' --dev=reload,xml' }
    return $cmd
}

function Get-ActiveHoursSpan {
    <# Hours from Start to End on a 24-hour clock; End may be past midnight (22 -> 6 is 8 hours). #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][int]$Start, [Parameter(Mandatory)][int]$End)
    return ((($End - $Start) % 24) + 24) % 24
}

function Test-ActiveHours {
    <#
      Windows Update active hours: whole hours 0-23, start and end differ, and
      Windows accepts at most 18 hours, which leaves a window for restarts.
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][int]$Start, [Parameter(Mandatory)][int]$End)
    if ($Start -lt 0 -or $Start -gt 23 -or $End -lt 0 -or $End -gt 23) { return $false }
    $span = Get-ActiveHoursSpan -Start $Start -End $End
    return ($span -ge 1 -and $span -le 18)
}

function Get-HealthCheckAction {
    <#
      Decides what the health-check task does on one run. Returns one of:
        paused   setup, restore or "odoo-ctl stop" asked us to leave Odoo alone
        missing  the Odoo service is not installed
        ok       Odoo answers
        start    the service is stopped (it crashed and Windows gave up restarting it)
        wait     not answering yet, but starting, just started, or below the failure threshold
        restart  not answering for Threshold checks in a row
        backoff  too many restarts in the last hour; restarting again would not help
    #>
    [CmdletBinding()]
    param(
        [AllowEmptyString()][string]$ServiceStatus,
        [bool]$HttpOk,
        [int]$PreviousFailures = 0,
        [bool]$Paused = $false,
        [double]$ServiceUptimeMinutes = 999,
        [int]$RestartsLastHour = 0,
        [int]$Threshold = 2,
        [double]$GraceMinutes = 5,
        [int]$MaxRestartsPerHour = 3
    )
    if ($Paused) { return 'paused' }
    if (-not $ServiceStatus) { return 'missing' }
    if ($ServiceStatus -eq 'Running' -and $HttpOk) { return 'ok' }
    if ($ServiceStatus -match 'Pending$') { return 'wait' }
    if ($RestartsLastHour -ge $MaxRestartsPerHour) { return 'backoff' }
    if ($ServiceStatus -eq 'Stopped') { return 'start' }
    if ($ServiceUptimeMinutes -lt $GraceMinutes) { return 'wait' }
    if (($PreviousFailures + 1) -ge $Threshold) { return 'restart' }
    return 'wait'
}

function Get-AnswersProblems {
    <#
      Checks an answers file before it is shipped in a reseller package.
      Returns a list of problems (empty when the file can install with no questions).
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][System.Collections.IDictionary]$Answers,
        [Parameter(Mandatory)][string[]]$OdooVersions,
        [string[]]$AppKeys = @(),
        [string[]]$BundleKeys = @()
    )
    $problems = @()
    $known = @('Root', 'Mode', 'OdooVersion', 'RamProfile', 'Ssd', 'PgPort', 'HttpPort', 'CompanyName', 'DbName',
        'AdminLogin', 'AdminPassword', 'UiLanguage', 'Apps', 'OcaBundles', 'WithDemo', 'Defender', 'DisableSleep',
        'MakeNetworkPrivate', 'Backup', 'ActiveHours', 'HealthCheck')
    foreach ($k in $Answers.Keys) { if ($known -notcontains $k) { $problems += ('Unknown setting "{0}" (typo?).' -f $k) } }
    if ($Answers.Contains('Root') -and $Answers.Root -notmatch '^[A-Za-z]:\\[^"<>|?*]*$') { $problems += 'Root must be a folder like C:\Odoo.' }
    if ($Answers.Contains('Mode') -and @('prod', 'dev') -notcontains $Answers.Mode) { $problems += 'Mode must be "prod" or "dev".' }
    if ($Answers.Contains('OdooVersion') -and $OdooVersions -notcontains $Answers.OdooVersion) {
        $problems += ('OdooVersion must be one of: {0}.' -f ($OdooVersions -join ', '))
    }
    if ($Answers.Contains('RamProfile') -and @('4GB', '8GB', '16GB') -notcontains $Answers.RamProfile) { $problems += 'RamProfile must be 4GB, 8GB or 16GB.' }
    if ($Answers.Contains('UiLanguage') -and @('ar_001', 'en_US') -notcontains $Answers.UiLanguage) { $problems += 'UiLanguage must be ar_001 or en_US.' }
    if (-not $Answers.Contains('DbName') -or -not (Test-DatabaseName ([string]$Answers.DbName))) {
        $problems += 'DbName is required: start with a letter, then letters, digits, _ . - only.'
    }
    if (-not $Answers.Contains('CompanyName') -or ([string]$Answers.CompanyName).Length -lt 2) { $problems += 'CompanyName is required.' }
    if ($Answers.Contains('Apps')) {
        foreach ($a in @($Answers.Apps)) { if ($AppKeys.Count -gt 0 -and $AppKeys -notcontains $a) { $problems += ('Unknown app "{0}".' -f $a) } }
    }
    if ($Answers.Contains('OcaBundles')) {
        foreach ($b in @($Answers.OcaBundles)) { if ($BundleKeys.Count -gt 0 -and $BundleKeys -notcontains $b) { $problems += ('Unknown OCA bundle "{0}".' -f $b) } }
    }
    if ($Answers.Contains('Backup') -and $Answers.Backup -is [System.Collections.IDictionary] -and $Answers.Backup.Enabled) {
        $b = $Answers.Backup
        if (-not $b.Contains('Dir') -or [string]$b.Dir -notmatch '^[A-Za-z]:\\') { $problems += 'Backup.Dir must be a folder like D:\OdooBackups when backups are enabled.' }
        if ($b.Contains('Time') -and [string]$b.Time -notmatch '^([01]\d|2[0-3]):[0-5]\d$') { $problems += 'Backup.Time must be HH:mm (24h).' }
    }
    if ($Answers.Contains('ActiveHours') -and $Answers.ActiveHours -is [System.Collections.IDictionary] -and $Answers.ActiveHours.Enabled) {
        $h = $Answers.ActiveHours
        if (-not (Test-ActiveHours -Start ([int]$h.Start) -End ([int]$h.End))) {
            $problems += 'ActiveHours Start/End must be hours 0-23, at most 18 hours apart.'
        }
    }
    return $problems
}

function Get-InstallPaths {
    <# All install locations, derived from the root folder (default C:\Odoo). #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$Root)
    $r = $Root.TrimEnd('\')
    return [ordered]@{
        Root       = $r
        Python     = $r + '\python'
        PythonExe  = $r + '\python\python.exe'
        Venv       = $r + '\venv'
        VenvPython = $r + '\venv\Scripts\python.exe'
        PgHome     = $r + '\pgsql'
        PgBin      = $r + '\pgsql\bin'
        PgData     = $r + '\pgdata'
        Wkhtml     = $r + '\wkhtmltopdf'
        WkhtmlBin  = $r + '\wkhtmltopdf\bin'
        Src        = $r + '\src'
        OdooSrc    = $r + '\src\odoo'
        OdooBin    = $r + '\src\odoo\odoo-bin'
        OcaDir     = $r + '\addons\oca'
        CustomDir  = $r + '\addons\custom'
        Data       = $r + '\data'
        Conf       = $r + '\conf'
        OdooConf   = $r + '\conf\odoo.conf'
        Settings   = $r + '\conf\settings.json'
        Secrets    = $r + '\conf\secrets.json'
        Credentials = $r + '\conf\CREDENTIALS.txt'
        Logs       = $r + '\logs'
        Tools      = $r + '\tools'
        Downloads  = $r + '\downloads'
        State      = $r + '\state.json'
    }
}

Export-ModuleMember -Function *
